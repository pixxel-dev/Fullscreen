<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/tv_install_file_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Установка файла..."
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tv_step_shizuku"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="⏳ 1. Shizuku API (Тихая установка): проверка..."
        android:textSize="14sp"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tv_step_native_adb"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="⏳ 2. Native ADB TLS (Android 11+): ожидание..."
        android:textSize="14sp"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tv_step_local_adb"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="⏳ 3. Local ADB (Порт 5555): ожидание..."
        android:textSize="14sp"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tv_step_package_installer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="⏳ 4. PackageInstaller Session: ожидание..."
        android:textSize="14sp"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tv_step_file_provider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="⏳ 5. Системное окно (FileProvider): ожидание..."
        android:textSize="14sp"
        android:layout_marginBottom="16dp" />

    <ProgressBar
        android:id="@+id/pb_install_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true" />

</LinearLayout>
