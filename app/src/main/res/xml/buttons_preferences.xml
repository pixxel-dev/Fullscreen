<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">
    <SwitchPreferenceCompat
        app:key="hud_enabled"
        app:title="Включить оверлей"
        app:summary="Показывать плавающую кнопку поверх экрана"
        app:defaultValue="false" />

    <MultiSelectListPreference
        app:key="ihu_package"
        app:title="Приложения для запуска"
        app:summary="Выберите одно или несколько приложений" />

    <ListPreference
        app:key="overlay_position_x"
        app:title="Расположение кнопки"
        app:summary="Выберите сторону экрана для оверлея"
        app:entries="@array/position_entries"
        app:entryValues="@array/position_values"
        app:defaultValue="left"
        app:useSimpleSummaryProvider="true" />

    <Preference
        app:key="app_info"
        app:title="О приложении"
        app:summary="Версия: " />
</PreferenceScreen>
