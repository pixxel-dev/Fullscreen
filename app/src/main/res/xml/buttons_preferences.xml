<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <PreferenceCategory app:title="Меню быстрого запуска">
        <SwitchPreferenceCompat
            app:key="quick_launch_enabled"
            app:title="Постоянная кнопка-меню"
            app:summary="Показывать плавающую кнопку для быстрого запуска приложений"
            app:defaultValue="false" />

        <com.flyme.fscrn.SearchableMultiSelectListPreference
            app:key="quick_launch_apps"
            app:title="Приложения для меню"
            app:summary="Выберите приложения для меню быстрого запуска"
            app:dependency="quick_launch_enabled" />

        <ListPreference
            app:key="ql_position_x"
            app:title="Расположение кнопки"
            app:summary="Выберите сторону экрана"
            app:entries="@array/position_entries"
            app:entryValues="@array/position_values"
            app:defaultValue="left"
            app:useSimpleSummaryProvider="true"
            app:dependency="quick_launch_enabled" />

        <SeekBarPreference
            app:key="ql_button_size"
            app:title="Размер кнопки"
            app:min="30"
            android:max="150"
            app:defaultValue="48"
            app:showSeekBarValue="true"
            app:dependency="quick_launch_enabled" />
    </PreferenceCategory>

    <PreferenceCategory app:title="Авто-оверлей (На весь экран)">
        <SwitchPreferenceCompat
            app:key="fullscreen_overlay_enabled"
            app:title="Включить кнопку разворота"
            app:summary="Кнопка будет появляться поверх выбранных приложений"
            app:defaultValue="false" />

        <com.flyme.fscrn.SearchableMultiSelectListPreference
            app:key="fullscreen_apps"
            app:title="Приложения для разворота"
            app:summary="При открытии этих приложений будет появляться кнопка"
            app:dependency="fullscreen_overlay_enabled" />

        <ListPreference
            app:key="fs_position_x"
            app:title="Расположение кнопки"
            app:summary="Выберите сторону экрана"
            app:entries="@array/position_entries"
            app:entryValues="@array/position_values"
            app:defaultValue="left"
            app:useSimpleSummaryProvider="true"
            app:dependency="fullscreen_overlay_enabled" />

        <SeekBarPreference
            app:key="fs_button_size"
            app:title="Размер кнопки"
            app:min="30"
            android:max="150"
            app:defaultValue="48"
            app:showSeekBarValue="true"
            app:dependency="fullscreen_overlay_enabled" />
    </PreferenceCategory>

    <PreferenceCategory app:title="Глобальный масштаб интерфейса">
        <SeekBarPreference
            app:key="global_ui_scale"
            app:title="Плотность экрана (DPI)"
            app:summary="Изменяет размер всех элементов системы (требует ADB/Root)"
            app:min="120"
            android:max="600"
            app:defaultValue="160"
            app:showSeekBarValue="true" />

        <Preference
            app:key="apply_ui_scale"
            app:title="Применить масштаб"
            app:summary="Нажмите для применения выбранного масштаба" />

        <Preference
            app:key="reset_ui_scale"
            app:title="Сбросить масштаб"
            app:summary="Вернуть плотность экрана по умолчанию" />
    </PreferenceCategory>

    <PreferenceCategory app:title="Настройки ADB">
        <Preference
            app:key="adb_pairing"
            app:title="Сопряжение Android 11+"
            app:summary="Настроить беспроводную отладку через код (без ПК)"
            app:icon="@drawable/ic_adb_pairing" />
    </PreferenceCategory>

    <PreferenceCategory app:title="Права доступа (Обязательно!)">
        <Preference
            app:key="request_usage_stats"
            app:title="Разрешить доступ к истории использования"
            app:summary="Нажмите, чтобы выдать. Нужно для работы авто-оверлея (распознавание открытых окон)" />

        <Preference
            app:key="request_accessibility"
            app:title="(Опционально) Включить спец. возможности"
            app:summary="Нажмите, чтобы включить Flyme Tweak. Это сделает появление кнопок мгновенным без задержек" />
    </PreferenceCategory>

    <Preference
        app:key="app_info"
        app:layout="@layout/pref_about"
        app:selectable="false" />

</PreferenceScreen>
