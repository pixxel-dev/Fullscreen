<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <PreferenceCategory app:title="Меню быстрого запуска">
        <SwitchPreferenceCompat
            app:key="quick_launch_enabled"
            app:title="Постоянная кнопка-меню"
            app:summary="Показывать плавающую кнопку для быстрого запуска приложений"
            app:defaultValue="false" />

        <com.flyme.fscrn.ui.SearchableMultiSelectListPreference
            app:key="quick_launch_apps"
            app:title="Приложения для меню"
            app:summary="Выберите приложения для меню быстрого запуска"
            app:dependency="quick_launch_enabled" />

        <ListPreference
            app:key="ql_position_x"
            app:title="Расположение кнопки"
            app:summary="Выберите сторону экрана"
            app:entries="@array/position_entries"
            app:entryValues="@array/position_values"
            app:defaultValue="left"
            app:useSimpleSummaryProvider="true"
            app:dependency="quick_launch_enabled" />

        <SeekBarPreference
            app:key="ql_button_size"
            app:title="Размер кнопки"
            app:min="30"
            android:max="150"
            app:defaultValue="48"
            app:showSeekBarValue="true"
            app:dependency="quick_launch_enabled" />
    </PreferenceCategory>

    <PreferenceCategory app:title="Авто-оверлей (На весь экран)">
        <SwitchPreferenceCompat
            app:key="fullscreen_overlay_enabled"
            app:title="Включить кнопку разворота"
            app:summary="Кнопка будет появляться поверх выбранных приложений"
            app:defaultValue="false" />

        <com.flyme.fscrn.ui.SearchableMultiSelectListPreference
            app:key="fullscreen_apps"
            app:title="Приложения для разворота"
            app:summary="При открытии этих приложений будет появляться кнопка"
            app:dependency="fullscreen_overlay_enabled" />

        <ListPreference
            app:key="fs_position_x"
            app:title="Расположение кнопки"
            app:summary="Выберите сторону экрана"
            app:entries="@array/position_entries"
            app:entryValues="@array/position_values"
            app:defaultValue="left"
            app:useSimpleSummaryProvider="true"
            app:dependency="fullscreen_overlay_enabled" />

        <SeekBarPreference
            app:key="fs_button_size"
            app:title="Размер кнопки"
            app:min="30"
            android:max="150"
            app:defaultValue="48"
            app:showSeekBarValue="true"
            app:dependency="fullscreen_overlay_enabled" />
    </PreferenceCategory>

    <PreferenceCategory app:title="Настройка блока кнопок">
        <SwitchPreferenceCompat
            app:key="separate_buttons_enabled"
            app:title="Разделять плавающие кнопки"
            app:summary="Управлять кнопками «Быстрый запуск» и «Разворот» отдельно"
            app:defaultValue="false" />

        <ListPreference
            app:key="combined_position_x"
            app:title="Расположение блока"
            app:summary="Выберите сторону экрана"
            app:entries="@array/position_entries"
            app:entryValues="@array/position_values"
            app:defaultValue="left"
            app:useSimpleSummaryProvider="true" />

        <SeekBarPreference
            app:key="combined_button_size"
            app:title="Размер кнопок в блоке"
            app:min="30"
            android:max="150"
            app:defaultValue="48"
            app:showSeekBarValue="true" />
    </PreferenceCategory>

    <PreferenceCategory app:title="Масштаб интерфейса приложения">
        <SeekBarPreference
            app:key="local_app_scale_percent"
            app:title="Размер интерфейса (%)"
            app:summary="Изменяет масштаб только в этом приложении. Требуется перезапуск."
            app:min="50"
            android:max="250"
            app:defaultValue="100"
            app:showSeekBarValue="true" />

        <Preference
            app:key="restart_app_scale"
            app:title="Перезагрузить приложение"
            app:summary="Нажмите для применения нового масштаба" />
    </PreferenceCategory>

    <PreferenceCategory app:title="Настройки ADB">
        <Preference
            app:key="adb_pairing"
            app:title="Сопряжение Android 11+"
            app:summary="Настроить беспроводную отладку через код (без ПК)"
            app:icon="@drawable/ic_adb_pairing" />
    </PreferenceCategory>

    <PreferenceCategory app:title="Права доступа">
        <PreferenceScreen
            app:key="permissions_subscreen"
            app:title="Разрешения приложения"
            app:summary="Управление всеми правами из манифеста">

            <SwitchPreferenceCompat
                app:key="perm_usage_stats"
                app:title="Доступ к истории использования"
                app:persistent="false" />

            <SwitchPreferenceCompat
                app:key="perm_overlay"
                app:title="Отображение поверх других окон"
                app:persistent="false" />

            <SwitchPreferenceCompat
                app:key="perm_manage_storage"
                app:title="Управление всем накопителем"
                app:persistent="false" />

            <SwitchPreferenceCompat
                app:key="perm_install_packages"
                app:title="Установка неизвестных приложений"
                app:persistent="false" />

            <SwitchPreferenceCompat
                app:key="perm_notifications"
                app:title="Отправка уведомлений"
                app:persistent="false" />

            <SwitchPreferenceCompat
                app:key="perm_shizuku"
                app:title="Доступ к Shizuku API"
                app:persistent="false" />

        </PreferenceScreen>
    </PreferenceCategory>

    <Preference
        app:key="app_info"
        app:layout="@layout/pref_about"
        app:selectable="false" />

</PreferenceScreen>
